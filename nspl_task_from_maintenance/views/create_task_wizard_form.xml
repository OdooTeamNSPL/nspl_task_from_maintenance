<odoo>
    <record id="view_maintenance_task_wizard_form" model="ir.ui.view">
        <field name="name">maintenance.request.wizard.form</field>
        <field name="model">maintenance.request.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Task">
                <group>

                    <field name="name" widget="text" placeholder="Task Title..." style="width:80%;"/>
                    <group>
                        <field name="project_id"/>
                        <field name="user_ids" widget="many2many_tags"/>
                        <field name="description"/>
                    </group>

                    <group>
                        <field name="planned_hours"/>
                        <field name="deadline"/>
                        <field name="tag_ids" widget="many2many_tags"/>
                    </group>

                </group>

                <footer>
                    <button string="Create Task" type="object" name="action_create_task" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_maintenance_task_wizard" model="ir.actions.act_window">
        <field name="name">maintenance request wizard</field>
        <field name="res_model">maintenance.request.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_maintenance_task_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
